  const scanCameraWrapper = document.getElementById('scanCameraContentWrapper');
  const scanAnimalNowBtn = document.getElementById('scanAnimalNowBtn');
  const scanCameraCloseBtn = document.getElementById('scanCameraCloseBtn');
  const scanCameraDragHandle = document.getElementById('scanCameraDragHandle');
  const scanCameraNewAnimalBtn = document.getElementById('scanCameraNewAnimalBtn');
  const scanCameraFeedback = document.getElementById('scanCameraFeedback');
  const scanCameraFeedbackText = document.getElementById('scanCameraFeedbackText');

  function openScanCameraModal() {
    if (!scanCameraModal) return;
    if (scanCameraFeedback) scanCameraFeedback.classList.add('hidden');
    scanCameraModal.classList.remove('invisible', 'pointer-events-none');
    scanCameraModal.classList.add('pointer-events-auto');
    scanCameraModal.setAttribute('aria-hidden', 'false');
    
    requestAnimationFrame(() => {
      scanCameraModal.classList.remove('opacity-0');
      scanCameraModal.classList.add('opacity-100');
      scanCameraBackdrop.classList.remove('opacity-0');
      scanCameraBackdrop.classList.add('opacity-100');
      scanCameraWrapper.classList.remove('translate-y-full');
      scanCameraWrapper.classList.add('translate-y-0');
    });
  }

  function closeScanCameraModal() {
    if (!scanCameraModal) return;
    scanCameraWrapper.classList.remove('translate-y-0');
    scanCameraWrapper.classList.add('translate-y-full');
    scanCameraBackdrop.classList.remove('opacity-100');
    scanCameraBackdrop.classList.add('opacity-0');
    scanCameraModal.classList.remove('opacity-100');
    scanCameraModal.classList.add('opacity-0');

    setTimeout(() => {
      scanCameraModal.classList.add('invisible', 'pointer-events-none');
      scanCameraModal.classList.remove('pointer-events-auto');
      scanCameraModal.setAttribute('aria-hidden', 'true');
    }, 300);
  }

  function triggerScanCameraAction(msg) {
    if (scanCameraFeedback && scanCameraFeedbackText) {
      scanCameraFeedbackText.textContent = msg;
      scanCameraFeedback.classList.remove('hidden');
      setTimeout(() => {
        closeScanCameraModal();
      }, 900);
    }
  }

  if (scanAnimalNowBtn) {
    scanAnimalNowBtn.addEventListener('click', (e) => {
      e.preventDefault();
      openScanCameraModal();
    });
  }
  if (scanCameraCloseBtn) scanCameraCloseBtn.addEventListener('click', closeScanCameraModal);
  if (scanCameraBackdrop) scanCameraBackdrop.addEventListener('click', closeScanCameraModal);
  if (scanCameraDragHandle) scanCameraDragHandle.addEventListener('click', closeScanCameraModal);

  if (scanCameraNewAnimalBtn) {
    scanCameraNewAnimalBtn.addEventListener('click', () => {
      triggerScanCameraAction("Starting camera for New / Unregistered Animal...");
    });
  }

  // Camera items click handlers
  document.querySelectorAll('.scan-camera-item').forEach(btn => {
    btn.addEventListener('click', () => {
      const name = btn.dataset.animalName;
      document.querySelectorAll('.scan-camera-item').forEach(b => {
        b.classList.remove('ring-2', 'ring-primary', 'bg-primary-fixed/20', 'border-primary');
      });
      btn.classList.add('ring-2', 'ring-primary', 'bg-primary-fixed/20', 'border-primary');
      triggerScanCameraAction(`Starting camera scanner for ${name}...`);
    });
  });

  /* -------------------------------------------------------------
     POPUP 2: Dedicated Modal Logic for "Upload from Gallery"
     ------------------------------------------------------------- */
  const uploadGalleryModal = document.getElementById('uploadGalleryModal');
  const uploadGalleryBackdrop = document.getElementById('uploadGalleryBackdrop');
  const uploadGalleryWrapper = document.getElementById('uploadGalleryContentWrapper');
  const uploadFromGalleryBtn = document.getElementById('uploadFromGalleryBtn');
  const uploadGalleryCloseBtn = document.getElementById('uploadGalleryCloseBtn');
  const uploadGalleryDragHandle = document.getElementById('uploadGalleryDragHandle');
  const uploadGalleryNewAnimalBtn = document.getElementById('uploadGalleryNewAnimalBtn');
  const uploadGalleryFeedback = document.getElementById('uploadGalleryFeedback');
  const uploadGalleryFeedbackText = document.getElementById('uploadGalleryFeedbackText');

  function openUploadGalleryModal() {
    if (!uploadGalleryModal) return;
    if (uploadGalleryFeedback) uploadGalleryFeedback.classList.add('hidden');
    uploadGalleryModal.classList.remove('invisible', 'pointer-events-none');
    uploadGalleryModal.classList.add('pointer-events-auto');
    uploadGalleryModal.setAttribute('aria-hidden', 'false');

    requestAnimationFrame(() => {
      uploadGalleryModal.classList.remove('opacity-0');
      uploadGalleryModal.classList.add('opacity-100');
      uploadGalleryBackdrop.classList.remove('opacity-0');
      uploadGalleryBackdrop.classList.add('opacity-100');
      uploadGalleryWrapper.classList.remove('translate-y-full');
      uploadGalleryWrapper.classList.add('translate-y-0');
    });
  }

  function closeUploadGalleryModal() {
    if (!uploadGalleryModal) return;
    uploadGalleryWrapper.classList.remove('translate-y-0');
    uploadGalleryWrapper.classList.add('translate-y-full');
    uploadGalleryBackdrop.classList.remove('opacity-100');
    uploadGalleryBackdrop.classList.add('opacity-0');
    uploadGalleryModal.classList.remove('opacity-100');
    uploadGalleryModal.classList.add('opacity-0');

    setTimeout(() => {
      uploadGalleryModal.classList.add('invisible', 'pointer-events-none');
      uploadGalleryModal.classList.remove('pointer-events-auto');
      uploadGalleryModal.setAttribute('aria-hidden', 'true');
    }, 300);
  }

  function triggerUploadGalleryAction(msg) {
    if (uploadGalleryFeedback && uploadGalleryFeedbackText) {
      uploadGalleryFeedbackText.textContent = msg;
      uploadGalleryFeedback.classList.remove('hidden');
      setTimeout(() => {
        closeUploadGalleryModal();
      }, 900);
    }
  }

  if (uploadFromGalleryBtn) {
    uploadFromGalleryBtn.addEventListener('click', (e) => {
      e.preventDefault();
      openUploadGalleryModal();
    });
  }
  if (uploadGalleryCloseBtn) uploadGalleryCloseBtn.addEventListener('click', closeUploadGalleryModal);
  if (uploadGalleryBackdrop) uploadGalleryBackdrop.addEventListener('click', closeUploadGalleryModal);
  if (uploadGalleryDragHandle) uploadGalleryDragHandle.addEventListener('click', closeUploadGalleryModal);

  if (uploadGalleryNewAnimalBtn) {
    uploadGalleryNewAnimalBtn.addEventListener('click', () => {
      triggerUploadGalleryAction("Opening photo library for New / Unregistered Animal...");
    });
  }

  // Gallery items click handlers
  document.querySelectorAll('.upload-gallery-item').forEach(btn => {
    btn.addEventListener('click', () => {
      const name = btn.dataset.animalName;
      document.querySelectorAll('.upload-gallery-item').forEach(b => {
        b.classList.remove('ring-2', 'ring-primary', 'bg-primary-fixed/20', 'border-primary');
      });
      btn.classList.add('ring-2', 'ring-primary', 'bg-primary-fixed/20', 'border-primary');
      triggerUploadGalleryAction(`Selecting gallery image for ${name}...`);
    });
  });

  // Global ESC key listener to close whichever modal is active
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (scanCameraModal && !scanCameraModal.classList.contains('invisible')) {
        closeScanCameraModal();
      }
      if (uploadGalleryModal && !uploadGalleryModal.classList.contains('invisible')) {
        closeUploadGalleryModal();
      }
    }
  });
</script>
<script>
  (function initLiquidDock() {
    const dockContainer = document.getElementById('liquidDockContainer');
    const dock = document.getElementById('liquidGlassDock');
    const pill = document.getElementById('liquidActivePill');
    const items = Array.from(dock.querySelectorAll('.dock-item'));
    const glow = document.getElementById('dockSpecularGlow');
    
    let activeIndex = 0;
    let isTracking = false;

    function updatePillPosition(index, stretch = 1) {
      if (!items[index] || !pill) return;
      const targetItem = items[index];
      const left = targetItem.offsetLeft;
      const width = targetItem.offsetWidth;
      pill.style.width = `${width}px`;
      pill.style.transform = `translateX(${left}px) scaleX(${stretch})`;
    }

    function setActiveTab(index) {
      activeIndex = index;
      items.forEach((item, idx) => {
        const icon = item.querySelector('.material-symbols-outlined');
        const isActive = idx === index;
        if (isActive) {
          item.classList.add('text-primary', 'font-bold');
          item.classList.remove('text-on-surface-variant');
          item.setAttribute('aria-current', 'page');
          if (icon) icon.style.fontVariationSettings = "'FILL' 1";
        } else {
          item.classList.remove('text-primary', 'font-bold');
          item.classList.add('text-on-surface-variant');
          item.removeAttribute('aria-current');
          if (icon) icon.style.fontVariationSettings = "'FILL' 0";
        }
      });
      updatePillPosition(index, 1);
    }

    // Initialize pill position
    window.addEventListener('DOMContentLoaded', () => updatePillPosition(activeIndex));
    window.addEventListener('resize', () => updatePillPosition(activeIndex));
    setTimeout(() => updatePillPosition(activeIndex), 50);

    // Physics proximity & magnification calculation
    function applyDockMagnification(clientX, clientY) {
      const rect = dock.getBoundingClientRect();
      const relativeX = clientX - rect.left;
      const relativeY = clientY - rect.top;

      // Update specular refraction coordinates
      dock.style.setProperty('--pointer-x', `${Math.max(0, Math.min(rect.width, relativeX))}px`);
      dock.style.setProperty('--pointer-y', `${Math.max(0, Math.min(rect.height, relativeY))}px`);
      if (glow) glow.style.opacity = '0.9';

      items.forEach((item, idx) => {
        const itemRect = item.getBoundingClientRect();
        const itemCenterX = itemRect.left + itemRect.width / 2;
        const dist = Math.abs(clientX - itemCenterX);
        const maxDist = 120; // proximity influence radius

        if (dist < maxDist) {
          // Dynamic bell curve scaling
          const factor = 1 - dist / maxDist;
          const scale = 1 + 0.22 * Math.pow(factor, 1.4);
          const translateY = -4 * factor;
          item.style.transform = `scale(${scale.toFixed(3)}) translateY(${translateY.toFixed(1)}px)`;
        } else {
          item.style.transform = 'scale(1) translateY(0px)';
        }
      });
    }

    function resetDockMagnification() {
      items.forEach(item => {
        item.style.transform = 'scale(1) translateY(0px)';
      });
      if (glow) glow.style.opacity = '0.5';
      updatePillPosition(activeIndex, 1);
    }

    // Pointer & Drag handling
    dock.addEventListener('pointerenter', (e) => {
      isTracking = true;
      applyDockMagnification(e.clientX, e.clientY);
    });

    dock.addEventListener('pointermove', (e) => {
      isTracking = true;
      applyDockMagnification(e.clientX, e.clientY);
    });

    dock.addEventListener('pointerleave', () => {
      isTracking = false;
      resetDockMagnification();
    });

    // Touch support for dragging smoothly across the pill dock
    dock.addEventListener('touchmove', (e) => {
      if (e.touches && e.touches[0]) {
        const touch = e.touches[0];
        applyDockMagnification(touch.clientX, touch.clientY);
      }
    }, { passive: true });

    dock.addEventListener('touchend', () => {
      resetDockMagnification();
    });

    // Item click / tap handling with elastic ripple feedback
    items.forEach((item, index) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        
        // Elastic pill morph stretch effect
        const stretchDirection = index > activeIndex ? 1.15 : (index < activeIndex ? 1.15 : 1.05);
        updatePillPosition(index, stretchDirection);
        setTimeout(() => updatePillPosition(index, 1), 160);

        setActiveTab(index);

        // Haptic-like visual pulse
        const iconWrapper = item.querySelector('.dock-icon-wrapper');
        if (iconWrapper) {
          iconWrapper.style.transform = 'scale(0.82)';
          setTimeout(() => {
            iconWrapper.style.transform = 'scale(1.22)';
            setTimeout(() => {
              iconWrapper.style.transform = 'scale(1)';
            }, 180);
          }, 80);
        }
      });
    });
  })();
</script>














