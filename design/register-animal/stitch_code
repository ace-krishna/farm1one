<script data-purpose="species-and-coat-color-handlers">
  window.selectSpeciesRow = function(targetRow) {
    var container = targetRow.closest('[data-purpose="species-unified-container"]');
    if (!container) return;
    var allRows = container.querySelectorAll('.species-row');
    var speciesInput = document.getElementById('selected-species-input');
    var targetSpecies = targetRow.getAttribute('data-species');
    var prevSpecies = speciesInput ? speciesInput.value : '';
    if (speciesInput && targetSpecies) speciesInput.value = targetSpecies;

    allRows.forEach(function(row) {
      var isTarget = (row === targetRow);
      var badge = row.querySelector('.species-badge');
      var title = row.querySelector('.species-title');
      var sub = row.querySelector('.species-subtitle');
      var swatchesContainer = row.querySelector('.swatches-container');
      var swatches = row.querySelectorAll('.swatch-input');
      var isLast = !row.nextElementSibling || !row.nextElementSibling.classList.contains('species-row');
      var borderClass = isLast ? '' : 'border-b border-[#e3ebe5]';
      
      if (isTarget) {
        row.className = 'species-row p-3.5 bg-[#f0f6f2] flex items-center justify-between gap-3 ' + borderClass + ' relative cursor-pointer transition-colors';
        if (badge) badge.classList.remove('hidden');
        if (title) title.className = 'text-base font-extrabold text-[#11352a] tracking-tight block species-title';
        if (sub) {
          sub.className = targetSpecies === 'cow' ? 'species-subtitle text-[11px] font-semibold text-emerald-800' :
                          targetSpecies === 'buffalo' ? 'species-subtitle text-[11px] font-semibold text-emerald-800' :
                          targetSpecies === 'hen' ? 'species-subtitle text-[11px] font-semibold text-emerald-800' :
                          'species-subtitle text-[11px] font-semibold text-emerald-800';
        }
        if (swatchesContainer) {
          swatchesContainer.classList.remove('opacity-40');
          swatchesContainer.classList.add('opacity-100');
        }
        
        // Ensure at least one swatch is selected for active species if none selected
        var hasChecked = false;
        swatches.forEach(function(s) { if (s.checked) hasChecked = true; });
        if (!hasChecked && swatches.length > 0) {
          swatches[0].checked = true;
          updateSwatchIndicators(row);
        } else {
          updateSwatchIndicators(row);
        }
      } else {
        row.className = 'species-row p-3.5 bg-white hover:bg-gray-50 flex items-center justify-between gap-3 ' + borderClass + ' transition-colors cursor-pointer';
        if (badge) badge.classList.add('hidden');
        if (title) title.className = 'text-base font-bold text-gray-800 tracking-tight block species-title';
        if (sub) sub.className = 'species-subtitle text-[11px] font-medium text-gray-500';
        if (swatchesContainer) {
          swatchesContainer.classList.remove('opacity-100');
          swatchesContainer.classList.add('opacity-40');
        }
        // Deselect swatches of unselected rows
        swatches.forEach(function(s) { s.checked = false; });
        updateSwatchIndicators(row);
      }
    });

    // Update dynamic breed options
    updateBreedSection(targetSpecies);

    // Update Age Estimation stepper units and calculation
    handleSpeciesAgeUnits(targetSpecies, prevSpecies);
  };

  function updateBreedSection(species) {
    var breedSec = document.getElementById('dynamic-breed-section');
    var cowGroup = document.getElementById('cow-breed-group');
    var henGroup = document.getElementById('hen-breed-group');
    if (!breedSec || !cowGroup || !henGroup) return;

    if (species === 'cow') {
      breedSec.classList.remove('hidden');
      cowGroup.classList.remove('hidden');
      henGroup.classList.add('hidden');
    } else if (species === 'hen') {
      breedSec.classList.remove('hidden');
      cowGroup.classList.add('hidden');
      henGroup.classList.remove('hidden');
    } else {
      // Buffalo, Goat, or any other
      breedSec.classList.add('hidden');
      cowGroup.classList.add('hidden');
      henGroup.classList.add('hidden');
    }
  }

  window.selectCowBreed = function(selectedBtn) {
    var buttons = document.querySelectorAll('.cow-breed-btn');
    buttons.forEach(function(btn) {
      var isTarget = (btn === selectedBtn);
      var ind = btn.querySelector('.breed-radio-indicator');
      var title = btn.querySelector('.text-sm');
      if (isTarget) {
        btn.setAttribute('aria-checked', 'true');
        btn.className = 'cow-breed-btn w-full p-3 rounded-2xl flex items-center justify-between text-left transition-all border-2 border-[#1b4d3e] bg-[#f0f6f2] shadow-xs touch-press';
        if (ind) {
          ind.className = 'w-7 h-7 rounded-full bg-[#1b4d3e] text-white flex items-center justify-center text-xs shrink-0 breed-radio-indicator';
        }
        if (title) {
          title.className = 'text-sm font-bold text-[#11352a] block';
        }
      } else {
        btn.setAttribute('aria-checked', 'false');
        btn.className = 'cow-breed-btn w-full p-3 rounded-2xl flex items-center justify-between text-left transition-all border border-[#dde6e0] bg-white hover:bg-gray-50 touch-press';
        if (ind) {
          ind.className = 'w-7 h-7 rounded-full border-2 border-gray-300 bg-white text-transparent flex items-center justify-center text-xs shrink-0 breed-radio-indicator';
        }
        if (title) {
          title.className = 'text-sm font-bold text-gray-800 block';
        }
      }
    });
  };

  window.selectHenBreed = function(selectedBtn) {
    var buttons = document.querySelectorAll('.hen-breed-btn');
    buttons.forEach(function(btn) {
      var isTarget = (btn === selectedBtn);
      var icon = btn.querySelector('.hen-breed-icon');
      var label = btn.querySelector('.text-sm');
      if (isTarget) {
        btn.setAttribute('aria-checked', 'true');
        btn.className = 'hen-breed-btn p-3 rounded-2xl flex flex-col items-center justify-center text-center gap-1 transition-all border-2 border-[#1b4d3e] bg-[#f0f6f2] shadow-xs touch-press';
        if (icon) {
          icon.className = 'w-8 h-8 rounded-full bg-[#1b4d3e] text-white flex items-center justify-center text-base hen-breed-icon';
        }
        if (label) {
          label.className = 'text-sm font-bold text-[#11352a]';
        }
      } else {
        btn.setAttribute('aria-checked', 'false');
        btn.className = 'hen-breed-btn p-3 rounded-2xl flex flex-col items-center justify-center text-center gap-1 transition-all border border-[#dde6e0] bg-white hover:bg-gray-50 touch-press';
        if (icon) {
          icon.className = 'w-8 h-8 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center text-base hen-breed-icon';
        }
        if (label) {
          label.className = 'text-sm font-bold text-gray-700';
        }
      }
    });
  };

  function updateSwatchIndicators(row) {
    var swatches = row.querySelectorAll('.swatch-input');
    swatches.forEach(function(swatch) {
      var indicator = swatch.nextElementSibling;
      if (!indicator) return;
      var checkIcon = indicator.querySelector('.check-icon');
      if (swatch.checked) {
        indicator.style.boxShadow = '0 0 0 2px #ffffff, 0 0 0 4px #1b4d3e';
        indicator.style.transform = 'scale(1.08)';
        if (checkIcon) checkIcon.style.opacity = '1';
      } else {
        indicator.style.boxShadow = '';
        indicator.style.transform = '';
        if (checkIcon) checkIcon.style.opacity = '0';
      }
    });
  }

  window.onSwatchSelected = function(swatchInput) {
    var parentRow = swatchInput.closest('.species-row');
    if (!parentRow) return;
    
    // Check if the row is already active
    var badge = parentRow.querySelector('.species-badge');
    var isAlreadyActive = badge && !badge.classList.contains('hidden');
    
    if (!isAlreadyActive) {
      // Activate species row and select this swatch
      window.selectSpeciesRow(parentRow);
    }
    
    // Update swatch states in this row
    var swatches = parentRow.querySelectorAll('.swatch-input');
    swatches.forEach(function(s) {
      if (s !== swatchInput) s.checked = false;
    });
    swatchInput.checked = true;
    updateSwatchIndicators(parentRow);
  };
</script>
<script data-purpose="stepper-and-color-handlers">
    // Cache for preserving values when toggling species
    var previousMammalValues = { val1: 3, val2: 6 };
    var previousHenValues = { val1: 8, val2: 4 };

    function handleSpeciesAgeUnits(species, prevSpecies) {
      var unit1Label = document.getElementById('unit-1-label');
      var unit2Label = document.getElementById('unit-2-label');
      var val1El = document.getElementById('years-val');
      var val2El = document.getElementById('months-val');
      if (!unit1Label || !unit2Label || !val1El || !val2El) return;

      if (species === 'hen') {
        if (prevSpecies !== 'hen') {
          previousMammalValues.val1 = parseInt(val1El.textContent, 10);
          previousMammalValues.val2 = parseInt(val2El.textContent, 10);
          val1El.textContent = previousHenValues.val1;
          val2El.textContent = previousHenValues.val2;
        }
        unit1Label.textContent = 'Weeks';
        unit2Label.textContent = 'Days';
      } else {
        if (prevSpecies === 'hen') {
          previousHenValues.val1 = parseInt(val1El.textContent, 10);
          previousHenValues.val2 = parseInt(val2El.textContent, 10);
          val1El.textContent = previousMammalValues.val1;
          val2El.textContent = previousMammalValues.val2;
        }
        unit1Label.textContent = 'Years';
        unit2Label.textContent = 'Months';
      }
      updateCalculation();
    }

    // Interactive stepper controls for Age Estimation
    function changeValue(id, delta) {
      const el = document.getElementById(id);
      let currentVal = parseInt(el.textContent, 10);
      currentVal = Math.max(0, currentVal + delta);
      el.textContent = currentVal;
      updateCalculation();
    }

    function changeMonth(id, delta) {
      const el = document.getElementById(id);
      const speciesInput = document.getElementById('selected-species-input');
      const isHen = speciesInput && speciesInput.value === 'hen';
      let currentVal = parseInt(el.textContent, 10);
      currentVal = currentVal + delta;
      
      if (isHen) {
        // Days roll within 0 - 6
        if (currentVal < 0) currentVal = 6;
        if (currentVal > 6) currentVal = 0;
      } else {
        // Months roll within 0 - 11
        if (currentVal < 0) currentVal = 11;
        if (currentVal > 11) currentVal = 0;
      }
      el.textContent = currentVal;
      updateCalculation();
    }

    function updateCalculation() {
      const speciesInput = document.getElementById('selected-species-input');
      const isHen = speciesInput && speciesInput.value === 'hen';
      const summaryText = document.getElementById('calc-summary-text');
      if (!summaryText) return;

      const val1 = parseInt(document.getElementById('years-val').textContent, 10);
      const val2 = parseInt(document.getElementById('months-val').textContent, 10);
      const today = new Date();

      if (isHen) {
        // val1 is Weeks, val2 is Days
        const totalDays = (val1 * 7) + val2;
        const estDate = new Date(today.getTime() - (totalDays * 24 * 60 * 60 * 1000));
        
        const monthNames = [
          "Jan", "Feb", "Mar", "Apr", "May", "Jun", 
          "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
        ];
        const dateStr = `${estDate.getDate()} ${monthNames[estDate.getMonth()]} ${estDate.getFullYear()}`;
        
        var ageParts = [];
        if (val1 > 0) ageParts.push(`${val1} ${val1 === 1 ? 'wk' : 'wks'}`);
        if (val2 > 0 || val1 === 0) ageParts.push(`${val2} ${val2 === 1 ? 'day' : 'days'}`);
        const ageLabel = ageParts.join(', ');

        summaryText.textContent = `${dateStr} (${ageLabel} old approx)`;
      } else {
        // val1 is Years, val2 is Months
        const targetDate = new Date(today.getFullYear() - val1, today.getMonth() - val2, 1);
        
        const monthNames = [
          "January", "February", "March", "April", "May", "June", 
          "July", "August", "September", "October", "November", "December"
        ];
        
        const targetMonth = monthNames[targetDate.getMonth()];
        const targetYear = targetDate.getFullYear();
        const totalYrs = (val1 + (val2 / 12)).toFixed(1);
        
        summaryText.textContent = `${targetMonth} ${targetYear} (${totalYrs} yrs)`;
      }
    }

    // Toggle behavior between Approx and Exact DOB
    const approxBtn = document.getElementById('approx-tab-btn');
    const exactBtn = document.getElementById('exact-tab-btn');

    if (approxBtn && exactBtn) {
      approxBtn.addEventListener('click', () => {
        approxBtn.className = "px-3 py-1 rounded-full text-xs font-bold bg-[#1b4d3e] text-white shadow-xs transition-all";
        exactBtn.className = "px-3 py-1 rounded-full text-xs font-semibold text-gray-600 hover:text-gray-900 transition-all";
      });

      exactBtn.addEventListener('click', () => {
        exactBtn.className = "px-3 py-1 rounded-full text-xs font-bold bg-[#1b4d3e] text-white shadow-xs transition-all";
        approxBtn.className = "px-3 py-1 rounded-full text-xs font-semibold text-gray-600 hover:text-gray-900 transition-all";
      });
    }

    // Sex toggle functionality
    function selectSex(sex) {
      const maleBtn = document.getElementById('sex-btn-male');
      const femaleBtn = document.getElementById('sex-btn-female');
      const sexInput = document.getElementById('animal-sex-input');
      
      if (!maleBtn || !femaleBtn) return;
      if (sexInput) sexInput.value = sex;

      const activeClass = "flex-1 flex items-center justify-center gap-2 py-2.5 px-3 rounded-full font-bold text-sm text-white bg-[#0B8F5C] shadow-sm border border-[#0B8F5C] transition-all touch-press";
      const inactiveClass = "flex-1 flex items-center justify-center gap-2 py-2.5 px-3 rounded-full font-bold text-sm text-[#1b4d3e] bg-transparent border border-transparent transition-all touch-press hover:text-gray-900";

      if (sex === 'male') {
        maleBtn.className = activeClass;
        maleBtn.setAttribute('aria-checked', 'true');
        maleBtn.setAttribute('aria-pressed', 'true');
        maleBtn.setAttribute('data-state', 'checked');

        femaleBtn.className = inactiveClass;
        femaleBtn.setAttribute('aria-checked', 'false');
        femaleBtn.setAttribute('aria-pressed', 'false');
        femaleBtn.setAttribute('data-state', 'unchecked');
      } else {
        femaleBtn.className = activeClass;
        femaleBtn.setAttribute('aria-checked', 'true');
        femaleBtn.setAttribute('aria-pressed', 'true');
        femaleBtn.setAttribute('data-state', 'checked');

        maleBtn.className = inactiveClass;
        maleBtn.setAttribute('aria-checked', 'false');
        maleBtn.setAttribute('aria-pressed', 'false');
        maleBtn.setAttribute('data-state', 'unchecked');
      }
    }
  </script>
