<script>
  (function () {
    const toast = document.getElementById('toast-notification');
    const toastText = document.getElementById('toast-text');

    let toastTimer = null;
    function showToast(msg) {
      if (!toast) return;
      if (toastTimer) clearTimeout(toastTimer);
      toastText.textContent = msg;
      toast.classList.remove('opacity-0', '-translate-y-12', 'pointer-events-none');
      toast.classList.add('opacity-100', 'translate-y-0');
      toastTimer = setTimeout(() => {
        toast.classList.add('opacity-0', '-translate-y-12', 'pointer-events-none');
        toast.classList.remove('opacity-100', 'translate-y-0');
      }, 2500);
    }

    // Active state tracker
    let selectedDate = '10';
    let currentSpeciesFilter = 'all';

    // References to groups and day-empty-state
    const overdueGroup = document.querySelector('.vaccination-group[data-group="overdue"]');
    const thisWeekGroup = document.querySelector('.vaccination-group[data-group="this-week"]');
    const laterGroup = document.querySelector('.vaccination-group[data-group="later"]');
    const dayEmptyState = document.getElementById('day-empty-state');
    const dayEmptyTitle = document.getElementById('day-empty-title');
    const dayEmptyDesc = document.getElementById('day-empty-desc');
    const thisWeekHeaderTitle = document.getElementById('this-week-header-title');
    const thisWeekHeaderBadge = document.getElementById('this-week-header-badge');
    const currentDateBadge = document.getElementById('current-date-badge');
    const badgeOverdue = document.getElementById('badge-count-overdue');
    const badgeThisWeek = document.getElementById('badge-count-this-week');
    const badgeLater = document.getElementById('badge-count-later');

    // Counts tracker
    function updateSummaryBar(overdueCount, thisWeekCount, laterCount) {
      if (badgeOverdue) badgeOverdue.textContent = `${overdueCount} overdue`;
      if (badgeThisWeek) {
        if (selectedDate === '10') {
          badgeThisWeek.textContent = `${thisWeekCount} this week`;
        } else {
          badgeThisWeek.textContent = `${thisWeekCount} scheduled`;
        }
      }
      if (badgeLater) badgeLater.textContent = `${laterCount} later`;

      const overdueWrapper = document.getElementById('badge-wrapper-overdue');
      const laterWrapper = document.getElementById('badge-wrapper-later');
      if (overdueWrapper) {
        if (selectedDate !== '10' && overdueCount === 0) {
          overdueWrapper.classList.add('opacity-40');
        } else {
          overdueWrapper.classList.remove('opacity-40');
        }
      }
      if (laterWrapper) {
        if (selectedDate !== '10') {
          laterWrapper.classList.add('opacity-40');
        } else {
          laterWrapper.classList.remove('opacity-40');
        }
      }
    }

    // Combined filter function for date + species
    function applyFilters() {
      const allCards = document.querySelectorAll('.vaccine-card');
      let visibleOverdue = 0;
      let visibleThisWeek = 0;
      let visibleLater = 0;

      if (selectedDate === '10') {
        // Tue 10 (Today view): show Overdue, This Week, and Later sections
        if (overdueGroup) overdueGroup.classList.remove('hidden');
        if (thisWeekGroup) thisWeekGroup.classList.remove('hidden');
        if (laterGroup) laterGroup.classList.remove('hidden');
        if (dayEmptyState) dayEmptyState.classList.add('hidden');

        if (thisWeekHeaderTitle) thisWeekHeaderTitle.textContent = 'This week';
        if (thisWeekHeaderBadge) thisWeekHeaderBadge.textContent = 'Priority Schedule';
        if (currentDateBadge) {
          currentDateBadge.textContent = 'Today';
          currentDateBadge.classList.remove('bg-surface-container-high', 'text-on-surface-variant');
          currentDateBadge.classList.add('bg-secondary-container', 'text-primary');
        }

        allCards.forEach(card => {
          if (card.classList.contains('card-dismissed')) return;
          const matchSpecies = (currentSpeciesFilter === 'all' || card.dataset.species === currentSpeciesFilter);
          if (matchSpecies) {
            card.classList.remove('hidden');
            const grp = card.closest('.vaccination-group');
            if (grp && grp.dataset.group === 'overdue') visibleOverdue++;
            if (grp && grp.dataset.group === 'this-week') visibleThisWeek++;
            if (grp && grp.dataset.group === 'later') visibleLater++;
          } else {
            card.classList.add('hidden');
          }
        });

        // Check empty states inside groups
        [overdueGroup, thisWeekGroup, laterGroup].forEach(checkSectionEmpty);
        updateSummaryBar(visibleOverdue, visibleThisWeek, visibleLater);

      } else {
        // Specific Day selected (Wed 11, Thu 12, Fri 13, Sat 14, Sun 15, Mon 16)
        if (overdueGroup) overdueGroup.classList.add('hidden');
        if (laterGroup) laterGroup.classList.add('hidden');

        // Target active day pill
        const activePill = document.querySelector(`.day-pill[data-date="${selectedDate}"]`);
        const fullDay = activePill ? activePill.dataset.fullDay : 'Day';
        const dayNum = activePill ? activePill.dataset.date : selectedDate;
        const month = activePill ? activePill.dataset.month : 'Nov';

        if (currentDateBadge) {
          currentDateBadge.textContent = `${fullDay}`;
          currentDateBadge.classList.remove('bg-secondary-container', 'text-primary');
          currentDateBadge.classList.add('bg-surface-container-high', 'text-on-surface-variant');
        }

        if (thisWeekHeaderTitle) thisWeekHeaderTitle.textContent = `Due ${fullDay}, ${dayNum} ${month}`;
        if (thisWeekHeaderBadge) thisWeekHeaderBadge.textContent = 'Scheduled Dose';

        let countForDay = 0;
        allCards.forEach(card => {
          if (card.classList.contains('card-dismissed')) return;
          const cardDate = card.dataset.date;
          const matchDate = (cardDate === selectedDate);
          const matchSpecies = (currentSpeciesFilter === 'all' || card.dataset.species === currentSpeciesFilter);

          if (matchDate && matchSpecies) {
            card.classList.remove('hidden');
            countForDay++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (countForDay > 0) {
          if (thisWeekGroup) thisWeekGroup.classList.remove('hidden');
          if (dayEmptyState) dayEmptyState.classList.add('hidden');
          const emptyCard = thisWeekGroup ? thisWeekGroup.querySelector('.empty-state-card') : null;
          if (emptyCard) emptyCard.classList.add('hidden');
        } else {
          // Zero tasks for this day (e.g. Sat 14, Sun 15)
          if (thisWeekGroup) thisWeekGroup.classList.add('hidden');
          if (dayEmptyState) {
            dayEmptyState.classList.remove('hidden');
            if (dayEmptyTitle) dayEmptyTitle.textContent = `No vaccinations scheduled for ${fullDay}, ${dayNum} ${month}`;
            if (dayEmptyDesc) dayEmptyDesc.textContent = `All livestock are healthy and clear of due dates for ${fullDay}.`;
          }
        }

        updateSummaryBar(0, countForDay, 0);
      }
    }

    // Check if section container is empty
    function checkSectionEmpty(groupElem) {
      if (!groupElem) return;
      const visibleCards = groupElem.querySelectorAll('.vaccine-card:not(.hidden):not(.card-dismissed)');
      const emptyState = groupElem.querySelector('.empty-state-card');
      if (emptyState) {
        if (visibleCards.length === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    }

    // Interactive dismissal on Done button click
    document.querySelectorAll('.action-done').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (btn.disabled) return;
        btn.disabled = true;

        const animalName = btn.dataset.name || 'Livestock';
        const card = btn.closest('.vaccine-card');

        // Button micro-interaction: pulse fill & check icon highlight
        btn.classList.add('btn-done-pulse', 'bg-primary', 'text-on-primary');
        btn.classList.remove('bg-secondary-container', 'text-on-secondary-fixed-variant');
        btn.innerHTML = '<span class="material-symbols-outlined text-[20px] text-primary-fixed" style="font-variation-settings: \'FILL\' 1;">done_all</span>';

        showToast(`Vaccination marked complete for ${animalName}`);

        // Smooth slide & collapse dismissal animation
        if (card) {
          const currentHeight = card.offsetHeight;
          card.style.maxHeight = currentHeight + 'px';
          card.classList.add('card-dismissing');

          requestAnimationFrame(() => {
            setTimeout(() => {
              card.classList.add('card-dismissed');
            }, 30);
          });

          setTimeout(() => {
            card.remove();
            applyFilters();
          }, 340);
        }
      });
    });

    // Reschedule Bottom Sheet Trigger
    const modal = document.getElementById('reschedule-modal');
    const modalCard = document.getElementById('reschedule-modal-card');
    const modalTargetName = document.getElementById('reschedule-target-name');
    const closeModalBtn = document.getElementById('close-reschedule-btn');
    const cancelModalBtn = document.getElementById('cancel-reschedule-btn');
    const confirmRescheduleBtn = document.getElementById('confirm-reschedule-btn');

    document.querySelectorAll('.action-reschedule').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const name = btn.dataset.name || 'Animal';
        if (modalTargetName) modalTargetName.textContent = name;
        if (modal && modalCard) {
          modal.classList.remove('hidden', 'animate-fade-out');
          modal.classList.add('animate-fade-in');
          modalCard.classList.remove('animate-scale-down');
          modalCard.classList.add('animate-scale-up');
        }
      });
    });

    let isDismissingModal = false;
    function hideModal(callback) {
      if (!modal || !modalCard || isDismissingModal || modal.classList.contains('hidden')) return;
      isDismissingModal = true;
      modal.classList.remove('animate-fade-in');
      modal.classList.add('animate-fade-out');
      modalCard.classList.remove('animate-scale-up');
      modalCard.classList.add('animate-scale-down');

      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('animate-fade-out');
        modalCard.classList.remove('animate-scale-down');
        isDismissingModal = false;
        if (callback) callback();
      }, 190);
    }

    if (closeModalBtn) closeModalBtn.addEventListener('click', (e) => { e.stopPropagation(); hideModal(); });
    if (cancelModalBtn) cancelModalBtn.addEventListener('click', (e) => { e.stopPropagation(); hideModal(); });
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          hideModal();
        }
      });
    }

    if (confirmRescheduleBtn) {
      confirmRescheduleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        hideModal(() => {
          showToast('Vaccination schedule updated!');
        });
      });
    }

    // Species Filter Chips logic
    const filterChips = document.querySelectorAll('.filter-chip');
    filterChips.forEach(chip => {
      chip.addEventListener('click', () => {
        filterChips.forEach(c => {
          c.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm');
          c.classList.add('bg-surface-container-lowest', 'text-on-surface-variant');
        });
        chip.classList.remove('bg-surface-container-lowest', 'text-on-surface-variant');
        chip.classList.add('bg-primary', 'text-on-primary', 'shadow-sm');

        currentSpeciesFilter = chip.dataset.filter || 'all';
        applyFilters();
      });
    });

    // Vaccination Dropdown logic
    const dropBtn = document.getElementById('vac-type-btn');
    const dropMenu = document.getElementById('vac-type-menu');
    const dropLabel = document.getElementById('vac-type-label');

    if (dropBtn && dropMenu) {
      dropBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        dropMenu.classList.toggle('hidden');
      });

      document.addEventListener('click', (e) => {
        if (!dropBtn.contains(e.target) && !dropMenu.contains(e.target)) {
          dropMenu.classList.add('hidden');
        }
      });

      document.querySelectorAll('.vac-option').forEach(opt => {
        opt.addEventListener('click', () => {
          const text = opt.dataset.type;
          if (dropLabel) dropLabel.textContent = text;
          dropMenu.classList.add('hidden');
          showToast(`Filtered: ${text}`);
        });
      });
    }

    // 7-day pill tap logic & dynamic date header update & filter
    const dayPills = document.querySelectorAll('.day-pill');
    const dateHeader = document.getElementById('current-date-header');
    const resetToTodayBtn = document.getElementById('reset-to-today-btn');

    function selectDatePill(pill) {
      if (!pill) return;

      // 1. Deactivate all pills
      dayPills.forEach(p => {
        p.classList.remove('is-active', 'bg-primary', 'text-on-primary');
        p.classList.add('bg-surface-container-lowest', 'text-on-surface', 'hover:bg-surface-container-high');
        const daySpan = p.querySelector('.day-label');
        if (daySpan) {
          daySpan.classList.remove('text-primary-fixed-dim');
          daySpan.classList.add('text-outline');
        }
        const slot = p.querySelector('.day-indicator-slot');
        if (slot && p.dataset.inactiveSlot) {
          slot.innerHTML = p.dataset.inactiveSlot;
        }
      });

      // 2. Activate clicked pill with vibrant #66d488 accent
      pill.classList.remove('bg-surface-container-lowest', 'text-on-surface', 'hover:bg-surface-container-high');
      pill.classList.add('is-active');
      const activeDaySpan = pill.querySelector('.day-label');
      if (activeDaySpan) {
        activeDaySpan.classList.remove('text-outline');
      }

      // Active indicator dot in high-contrast dark green
      const activeSlot = pill.querySelector('.day-indicator-slot');
      if (activeSlot) {
        activeSlot.innerHTML = '<span class="day-indicator-dot w-1.5 h-1.5 rounded-full bg-[#003629]"></span>';
      }

      // 3. Update date header above (e.g. 'Wed 11 Nov')
      const day = pill.dataset.day || '';
      const date = pill.dataset.date || '';
      const month = pill.dataset.month || 'Nov';
      if (dateHeader && day && date) {
        dateHeader.textContent = `${day} ${date} ${month}`;
      }

      // 4. Update state & filter cards
      selectedDate = date;
      applyFilters();
    }

    dayPills.forEach(pill => {
      pill.addEventListener('click', () => {
        selectDatePill(pill);
      });
    });

    if (resetToTodayBtn) {
      resetToTodayBtn.addEventListener('click', () => {
        const todayPill = document.querySelector('.day-pill[data-date="10"]');
        if (todayPill) selectDatePill(todayPill);
      });
    }

    // Initial check
    applyFilters();
  })();
