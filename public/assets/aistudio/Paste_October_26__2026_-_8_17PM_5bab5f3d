  if (uploadGalleryBackdrop) uploadGalleryBackdrop.addEventListener('click', closeUploadGalleryModal);
  if (uploadGalleryDragHandle) uploadGalleryDragHandle.addEventListener('click', closeUploadGalleryModal);

  if (uploadGalleryNewAnimalBtn) {
    uploadGalleryNewAnimalBtn.addEventListener('click', () => {
      triggerUploadGalleryAction("Opening photo library for New / Unregistered Animal...");
    });
  }

  // Gallery items click handlers
  document.querySelectorAll('.upload-gallery-item').forEach(btn => {
    btn.addEventListener('click', () => {
      const name = btn.dataset.animalName;
      document.querySelectorAll('.upload-gallery-item').forEach(b => {
        b.classList.remove('ring-2', 'ring-primary', 'bg-primary-fixed/20', 'border-primary');
      });
      btn.classList.add('ring-2', 'ring-primary', 'bg-primary-fixed/20', 'border-primary');
      triggerUploadGalleryAction(`Selecting gallery image for ${name}...`);
    });
  });

  // Global ESC key listener to close whichever modal is active
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (scanCameraModal && !scanCameraModal.classList.contains('invisible')) {
        closeScanCameraModal();
      }
      if (uploadGalleryModal && !uploadGalleryModal.classList.contains('invisible')) {
        closeUploadGalleryModal();
      }
    }
  });
</script>
<script>
  (function initLiquidDock() {
    const dockContainer = document.getElementById('liquidDockContainer');
    const dock = document.getElementById('liquidGlassDock');
    const pill = document.getElementById('liquidActivePill');
    const items = Array.from(dock.querySelectorAll('.dock-item'));
    const glow = document.getElementById('dockSpecularGlow');
    
    let activeIndex = 0;
    let isTracking = false;

    function updatePillPosition(index, stretch = 1) {
      if (!items[index] || !pill) return;
      const targetItem = items[index];
      const left = targetItem.offsetLeft;
      const width = targetItem.offsetWidth;
      pill.style.width = `${width}px`;
      pill.style.transform = `translateX(${left}px) scaleX(${stretch})`;
    }

    function setActiveTab(index) {
      activeIndex = index;
      items.forEach((item, idx) => {
        const icon = item.querySelector('.material-symbols-outlined');
        const isActive = idx === index;
        if (isActive) {
          item.classList.add('text-primary', 'font-bold');
          item.classList.remove('text-on-surface-variant');
          item.setAttribute('aria-current', 'page');
          if (icon) icon.style.fontVariationSettings = "'FILL' 1";
        } else {
          item.classList.remove('text-primary', 'font-bold');
          item.classList.add('text-on-surface-variant');
          item.removeAttribute('aria-current');
          if (icon) icon.style.fontVariationSettings = "'FILL' 0";
        }
      });
      updatePillPosition(index, 1);
    }

    // Initialize pill position
    window.addEventListener('DOMContentLoaded', () => updatePillPosition(activeIndex));
    window.addEventListener('resize', () => updatePillPosition(activeIndex));
    setTimeout(() => updatePillPosition(activeIndex), 50);

    // Physics proximity & magnification calculation
    function applyDockMagnification(clientX, clientY) {
      const rect = dock.getBoundingClientRect();
      const relativeX = clientX - rect.left;
      const relativeY = clientY - rect.top;

      // Update specular refraction coordinates
      dock.style.setProperty('--pointer-x', `${Math.max(0, Math.min(rect.width, relativeX))}px`);
      dock.style.setProperty('--pointer-y', `${Math.max(0, Math.min(rect.height, relativeY))}px`);
      if (glow) glow.style.opacity = '0.9';

      items.forEach((item, idx) => {
        const itemRect = item.getBoundingClientRect();
        const itemCenterX = itemRect.left + itemRect.width / 2;
        const dist = Math.abs(clientX - itemCenterX);
        const maxDist = 120; // proximity influence radius

        if (dist < maxDist) {
          // Dynamic bell curve scaling
          const factor = 1 - dist / maxDist;
          const scale = 1 + 0.22 * Math.pow(factor, 1.4);
          const translateY = -4 * factor;
          item.style.transform = `scale(${scale.toFixed(3)}) translateY(${translateY.toFixed(1)}px)`;
        } else {
          item.style.transform = 'scale(1) translateY(0px)';
        }
      });
    }

    function resetDockMagnification() {
      items.forEach(item => {
        item.style.transform = 'scale(1) translateY(0px)';
      });
      if (glow) glow.style.opacity = '0.5';
      updatePillPosition(activeIndex, 1);
    }

    // Pointer & Drag handling
    dock.addEventListener('pointerenter', (e) => {
      isTracking = true;
      applyDockMagnification(e.clientX, e.clientY);
    });

    dock.addEventListener('pointermove', (e) => {
      isTracking = true;
      applyDockMagnification(e.clientX, e.clientY);
    });

    dock.addEventListener('pointerleave', () => {
      isTracking = false;
      resetDockMagnification();
    });

    // Touch support for dragging smoothly across the pill dock
    dock.addEventListener('touchmove', (e) => {
      if (e.touches && e.touches[0]) {
        const touch = e.touches[0];
        applyDockMagnification(touch.clientX, touch.clientY);
      }
    }, { passive: true });

    dock.addEventListener('touchend', () => {
      resetDockMagnification();
    });

    // Item click / tap handling with elastic ripple feedback
    items.forEach((item, index) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        
        // Elastic pill morph stretch effect
        const stretchDirection = index > activeIndex ? 1.15 : (index < activeIndex ? 1.15 : 1.05);
        updatePillPosition(index, stretchDirection);
        setTimeout(() => updatePillPosition(index, 1), 160);

        setActiveTab(index);

        // Haptic-like visual pulse
        const iconWrapper = item.querySelector('.dock-icon-wrapper');
        if (iconWrapper) {
          iconWrapper.style.transform = 'scale(0.82)';
          setTimeout(() => {
            iconWrapper.style.transform = 'scale(1.22)';
            setTimeout(() => {
              iconWrapper.style.transform = 'scale(1)';
            }, 180);
          }, 80);
        }
      });
    });
  })();
</script>
</body></html>